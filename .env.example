# Receipt Extractor - Environment Configuration Example
# Copy this file to .env and fill in your values

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary and Fallback Free Vision Models (Phase 2)
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,particle-ai/particle-1:free

# Backward Compatibility (same as OPENROUTER_PRIMARY_MODEL if unset)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Zero-Cost Protection: Strictly Disallow Paid Inference
ALLOW_PAID_MODELS=false

# Quota Monitoring
ENABLE_QUOTA_MONITORING=true
QUOTA_CACHE_TTL_SECONDS=60

# Request Timeouts (in seconds)
OPENROUTER_TIMEOUT=90
HTTP_REQUEST_TIMEOUT=300

# Database Configuration
DATABASE_URL=sqlite:///./receipts.db

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=5

# OCR Configuration
OCR_LANGUAGE=en

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_BASE_URL=http://127.0.0.1:8000
